{{!
    @template mod_imagemap/view

    Image map shown to students, with the clickable areas drawn over the image.

    The config is the JSON read by mod_imagemap/view: image URL, areas and lines.

    Example context (json):
    {"has_image": true, "imagemap_id": 1, "config": "{\"imageurl\": \"\", \"areas\": [], \"lines\": []}"}
}}
{{#has_image}}
<div id="imagemap-view-{{imagemap_id}}" class="imagemap-view" data-config="{{config}}">
    <canvas></canvas>
    <div class="imagemap-overlays"></div>
</div>
{{#has_manage}}
<div class="imagemap-manage">
    <a href="{{manage_url}}" class="btn btn-secondary">{{manage_text}}</a>
</div>
{{/has_manage}}
{{/has_image}}
{{^has_image}}
<div class="alert alert-warning">{{no_image_text}}</div>
{{#has_manage}}
<p><a href="{{edit_settings_url}}">{{edit_settings_text}}</a></p>
{{/has_manage}}
{{/has_image}}